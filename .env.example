# Proveedor de IA (gemini | openai | ollama | mock)
LLM_PROVIDER=mock
# Gemini (API nativa; acepta claves AIza y AQ.):
# OPENAI_API_KEY=AIza...  (clave de Google AI Studio)
# GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI u otro compatible (DeepSeek, Groq, etc.):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.deepseek.com  (para usar DeepSeek u otro compatible)
# OLLAMA_MODEL=llama3.2

# Servidor web
PORT=3000

# Bot de Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-...  (crea el bot con @BotFather)
# TG_ALLOWED_CHAT=123456789          (tu chat_id; varios separados por coma)

# Admin console
# ADMIN_PASSWORD=tu_password_aqui
