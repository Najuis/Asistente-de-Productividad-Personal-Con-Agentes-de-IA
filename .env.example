# Proveedor de IA (openai | ollama | mock)
LLM_PROVIDER=openai

# Clave de API (OpenRouter, DeepSeek, etc.) - NUNCA subas la real
OPENAI_API_KEY=sk-or-v1-TU_CLAVE_AQUI

# Modelo a usar
OPENAI_MODEL=qwen/qwen-2.5-72b-instruct

# URL base para APIs compatibles con OpenAI
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Puerto del servidor web
PORT=3000

# Bot de Telegram (opcional)
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TG_ALLOWED_CHAT=123456789

#Consola de administración (opcional)
#ADMIN_PASSWORD= 